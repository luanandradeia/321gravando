# ==============================================================================
# 321gravando - Configurações Gerais do Sistema
# ==============================================================================

# Código de Acesso / Senha do Painel Web (Padrão: 123gravar)
AUTH_CODE=123gravar

# Porta HTTP do Dashboard Web
PORT=8080

# Chave de API do Groq (Whisper-large-v3 para transcrição e Llama 3.3 para resumo)
GROQ_API_KEY=gsk_sua_chave_aqui

# Nome de exibição do Bot quando ele entrar na reunião do Google Meet
BOT_NAME="FULCRO ALAVANC Assistant"

# ------------------------------------------------------------------------------
# Configurações do Navegador & Servidor Linux (Debian 13 / Docker)
# ------------------------------------------------------------------------------

# Display da tela virtual Xvfb
DISPLAY=:99

# Caminho do executável do Chromium no Linux
CHROMIUM_PATH=/usr/bin/chromium

# ------------------------------------------------------------------------------
# Google Drive - Sincronização e Armazenamento na Nuvem
# ------------------------------------------------------------------------------

# Ativar upload automático para o Google Drive (true / false)
GDRIVE_ENABLED=true

# Opção A: Caminho para o arquivo JSON de credenciais da Service Account
GDRIVE_KEY_FILE=./gdrive-credentials.json

# Opção B (Alternativa): ID da pasta raiz no Google Drive
# Se deixar vazio ou comentado, o sistema cria/usa automaticamente a pasta '321gravando'
# GDRIVE_PARENT_FOLDER_ID=

# Opção C (Alternativa): Cole todo o JSON da Service Account em uma única linha (caso não queira usar arquivo)
# GDRIVE_SERVICE_ACCOUNT_JSON=
