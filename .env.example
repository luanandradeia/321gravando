# ==============================================================================
# 321gravando - Configurações do Ambiente
# ==============================================================================

# Chave da API do Groq (Whisper & Llama 3.3)
GROQ_API_KEY=gsk_sua_chave_aqui

# Porta para o Dashboard Web (Padrão: 8080)
PORT=8080

# Display Virtual Xvfb (Debian/Docker)
DISPLAY=:99

# Nome de exibição do Bot no Google Meet
BOT_NAME="Notetaker Assistant"

# Caminho do executável do Chromium no Debian 13
CHROMIUM_PATH=/usr/bin/chromium

# ------------------------------------------------------------------------------
# Google Drive (Upload Automático de Vídeos e Atas Markdown)
# ------------------------------------------------------------------------------

# Ativar sincronização com o Google Drive (true / false)
GDRIVE_ENABLED=true

# Opção 1: Caminho para o arquivo JSON de credenciais da Service Account
GDRIVE_KEY_FILE=./gdrive-credentials.json

# Opção 2: Conteúdo JSON da Service Account em linha única (alternativa ao arquivo)
# GDRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ID da pasta raiz no Google Drive (Opcional - se vazio, cria automaticamente '321gravando')
# GDRIVE_PARENT_FOLDER_ID=
